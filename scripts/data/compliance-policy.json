{
  "_comment": "Single source of truth for what may be published. Edit thresholds here, never in code. Every value is enforced by scripts/compliance-gate.mjs before any upload.",
  "version": "1.0.0",
  "updated": "2026-07-26",
  "youtube_limits": {
    "title_max_chars": 100,
    "description_max_chars": 5000,
    "tags_total_max_chars": 500,
    "tag_max_chars": 30,
    "tags_max_count": 15,
    "tags_min_count": 3,
    "shorts_max_seconds": 60,
    "title_max_hashtags": 3,
    "description_max_hashtags": 15,
    "_source": "YouTube Help: Add video metadata, and Shorts eligibility requirements."
  },
  "repetition": {
    "_comment": "Defends against the YouTube 'Mass-produced or repetitive content' policy, which is the single largest existential risk to a daily automated channel.",
    "max_title_similarity": 0.55,
    "max_description_similarity": 0.7,
    "max_hook_similarity": 0.5,
    "compare_against_last_n": 200,
    "forbid_exact_combo_reuse": true,
    "min_theme_gap": 3,
    "min_audio_gap": 2,
    "max_same_niche_per_day": 2,
    "max_same_niche_in_last_10": 4
  },
  "kid_safety": {
    "_comment": "Two tiers. hard_banned is blocked outright with no appeal. context_sensitive words are legitimate in educational science and history but need a judgement call, so they raise a warning and are referred to the AI safety reviewer. A flat list blocked 'jellyfish have no blood', which is why the split exists.",
    "hard_banned": [
      "murder",
      "murdered",
      "suicide",
      "torture",
      "rape",
      "porn",
      "pornographic",
      "nude",
      "naked",
      "erotic",
      "sexual",
      "cocaine",
      "heroin",
      "meth",
      "cannabis",
      "marijuana",
      "gambling",
      "casino",
      "betting",
      "terrorist",
      "terrorism",
      "massacre",
      "genocide",
      "execution",
      "behead",
      "republican",
      "democrat",
      "communist",
      "fascist",
      "nazi",
      "election",
      "senator",
      "congress",
      "prime minister",
      "president",
      "parliament",
      "abortion",
      "immigration"
    ],
    "context_sensitive": [
      "kill",
      "killed",
      "death",
      "died",
      "dead",
      "blood",
      "weapon",
      "gun",
      "knife",
      "bomb",
      "war",
      "battle",
      "attack",
      "poison",
      "venom",
      "disease",
      "virus",
      "cancer",
      "vaccine",
      "alcohol",
      "wine",
      "beer",
      "religion",
      "church",
      "god",
      "romance",
      "kiss",
      "drug"
    ],
    "_context_note": "These appear constantly in legitimate nature, science and history facts. Venomous animals, blood chemistry, historical wars, viruses in biology. Blocking them outright would gut the topic library."
  },
  "house_style": {
    "_comment": "Owner's stated brand rules. Violations are hard blocks because they ship into the public title and description.",
    "forbid_em_dash": true,
    "forbid_en_dash": true,
    "forbid_emoji": true,
    "require_uk_english": true,
    "us_spellings": {
      "color": "colour",
      "colors": "colours",
      "colored": "coloured",
      "customize": "customise",
      "customized": "customised",
      "customizing": "customising",
      "organize": "organise",
      "organized": "organised",
      "recognize": "recognise",
      "recognized": "recognised",
      "analyze": "analyse",
      "analyzed": "analysed",
      "center": "centre",
      "centers": "centres",
      "meter": "metre",
      "meters": "metres",
      "liter": "litre",
      "liters": "litres",
      "license": "licence",
      "defense": "defence",
      "offense": "offence",
      "traveled": "travelled",
      "traveling": "travelling",
      "favorite": "favourite",
      "behavior": "behaviour",
      "honor": "honour"
    }
  },
  "metadata_integrity": {
    "_comment": "Guards against the YouTube 'Spam, deceptive practices and scams' policy: misleading metadata and keyword stuffing.",
    "max_tag_repetition": 2,
    "require_title_matches_content": true,
    "forbid_clickbait_patterns": [
      "you won't believe",
      "you wont believe",
      "shocking truth",
      "doctors hate",
      "this one trick",
      "gone wrong",
      "gone sexual",
      "must watch",
      "number \\d+ will shock",
      "\\bshocking\\b",
      "insane",
      "click here",
      "free money",
      "get rich",
      "subscribe or"
    ],
    "forbid_all_caps_words_over": 4,
    "max_consecutive_punctuation": 1
  },
  "legal": {
    "_comment": "Copyright and consumer-law exposure. Audio is the highest-frequency real risk: Content ID claims on background beds routinely strip monetisation.",
    "require_audio_licence_record": true,
    "block_on_unknown_audio_licence": false,
    "acceptable_audio_licences": [
      "CC0",
      "Public Domain",
      "Pixabay Content Licence",
      "Mixkit Free Licence",
      "YouTube Audio Library",
      "Owned Original"
    ],
    "forbid_song_lyrics": true,
    "forbid_third_party_footage": true,
    "forbid_real_person_claims": true,
    "require_factual_sourcing": true,
    "trademark_care_terms": [
      "youtube",
      "google",
      "apple",
      "microsoft",
      "nintendo",
      "disney",
      "netflix",
      "amazon",
      "meta",
      "facebook",
      "instagram",
      "tiktok"
    ],
    "_trademark_note": "Nominative reference in an educational fact is fine. Implying endorsement, partnership or official status is not."
  },
  "coppa": {
    "_comment": "US COPPA and the YouTube made-for-kids setting. Getting this wrong carries FTC penalties, so it is asserted explicitly rather than left to a default.",
    "declared_made_for_kids": false,
    "require_explicit_declaration": true,
    "forbid_child_directed_signals": [
      "nursery rhyme",
      "for toddlers",
      "baby shark",
      "kids song",
      "colours for children",
      "learn abc",
      "counting for kids"
    ]
  },
  "ai_panel": {
    "_comment": "Independent model reviewers for judgement calls the rule engine cannot make. Requires a majority to pass.",
    "enabled": true,
    "required_pass_ratio": 0.66,
    "timeout_ms": 30000,
    "reviewers": [
      {
        "id": "factual",
        "provider": "perplexity",
        "focus": "Is every factual claim verifiably true and current?"
      },
      {
        "id": "safety",
        "provider": "anthropic",
        "focus": "Is this safe and appropriate for a broad audience including minors?"
      },
      {
        "id": "legal",
        "provider": "openai",
        "focus": "Any copyright, trademark, defamation or advertising-disclosure risk?"
      },
      {
        "id": "misleading",
        "provider": "gemini",
        "focus": "Does the title honestly represent the content, free of clickbait?"
      }
    ],
    "on_unavailable": "warn"
  },
  "quota": {
    "daily_units": 10000,
    "units_per_upload": 1600,
    "reserve_units": 1600,
    "max_uploads_per_day": 5
  },
  "enforcement": {
    "_comment": "block = refuse to upload. warn = upload but record. strict_mode escalates every warn to a block.",
    "strict_mode": false,
    "on_rule_fail": "block",
    "on_similarity_fail": "block",
    "on_ai_panel_fail": "block",
    "on_audio_licence_unknown": "warn",
    "halt_batch_on_any_block": false,
    "on_halal_fail": "block"
  },
