# deps
node_modules/

# build output
dist/
out/
.remotion/

# env
.env
.env.local
.env.*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / OS
.DS_Store
.idea/
.vscode/
*.suo
Thumbs.db

# Remotion cache
.cache/

# Credentials (NEVER commit)
#
# Glob patterns, not exact filenames. An exact-match rule missed
# scripts/scriptsoauth-client-bbm0902.json (a mistyped save path) and git add -A
# swept a live Google OAuth client secret into a commit. GitHub push protection
# caught it, but the ignore rule should have caught it first.
*oauth-client*.json
*yt-credentials*.json
*credentials*.json
*client_secret*.json
scripts/*.secret
.env
.env.*
!.env.example

# TypeScript incremental build info
*.tsbuildinfo

# Render logs are a per-run artefact, not source. They are written into the
# dated folder next to the props they describe, so without this every render
# leaves an untracked file behind and real changes get lost in the noise.
daily/*/render-log.txt
